rules_version = '2';

// Règles Firestore de MCNote.
//
// Chaque événement et chaque bloc-notes appartient à un compte, via son champ
// `owner`. Les sous-collections n'ont pas de propriétaire propre : elles
// héritent de celui de leur parent, vérifié par un get().
//
// Ce get() coûte une lecture par document lu ou écrit. C'est le prix de
// l'isolation : sans lui, tout compte authentifié lisait les conducteurs des
// autres. Les volumes en jeu — quelques dizaines de séquences par événement —
// le rendent négligeable.

service cloud.firestore {
  match /databases/{database}/documents {

    function estProprietaire(donnees) {
      return request.auth != null && request.auth.uid == donnees.owner;
    }

    // Le parent doit exister : une sous-collection orpheline, laissée par une
    // suppression ancienne, n'est accessible à personne. L'application supprime
    // toujours les enfants avant le parent, donc le cas ne se présente pas.
    function proprietaireDuParent(chemin) {
      return request.auth != null
          && exists(chemin)
          && get(chemin).data.owner == request.auth.uid;
    }

    match /events/{eventId} {
      allow read, write: if estProprietaire(resource.data);
      allow create: if estProprietaire(request.resource.data);

      match /sequences/{sequenceId} {
        allow read, write: if proprietaireDuParent(
          /databases/$(database)/documents/events/$(eventId));
      }

      match /categories/{categoryId} {
        allow read, write: if proprietaireDuParent(
          /databases/$(database)/documents/events/$(eventId));
      }
    }

    match /notebooks/{notebookId} {
      allow read, write: if estProprietaire(resource.data);
      allow create: if estProprietaire(request.resource.data);

      match /notes/{noteId} {
        allow read, write: if proprietaireDuParent(
          /databases/$(database)/documents/notebooks/$(notebookId));
      }
    }
  }
}
